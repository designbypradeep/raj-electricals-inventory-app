# Normalize text files to LF in repo
* text=auto eol=lf

# Common source files
*.dart text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.gradle text eol=lf
*.kt  text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.sh  text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Images and binaries
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.gif  binary
*.bmp  binary
*.pdf  binary
*.keystore binary
*.aab binary
*.apk binary
*.jar binary
*.zip binary
*.7z  binary
*.gz  binary
*.tgz binary
